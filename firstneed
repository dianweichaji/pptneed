    svg+=`<line x1="${pad.l}" y1="${y(mpe)}" x2="${w-pad.r}" y2="${y(mpe)}" stroke="#4f9e87" stroke-width="1.4" stroke-dasharray="5 5"/><line x1="${pad.l}" y1="${y(-mpe)}" x2="${w-pad.r}" y2="${y(-mpe)}" stroke="#4f9e87" stroke-width="1.4" stroke-dasharray="5 5"/><text x="${w-pad.r+7}" y="${y(mpe)+4}" font-size="10" fill="#14745f">+MPE ${mpe.toFixed(5)}</text><text x="${w-pad.r+7}" y="${y(-mpe)+4}" font-size="10" fill="#14745f">−MPE ${mpe.toFixed(5)}</text>`;
