    const rr=cands.map(x=>{const rec=state.retests[x.point.toFixed(1)]||{upValues:[],downValues:[]},a=retestAnalysis(x,rec);return `<tr><td>${x.point.toFixed(1)}</td><td>${esc(x.reason)}</td><td>${a.n||0}</td><td>${a.n>=3?f(a.meanI,5):'—'}</td><td>${a.n>=3?f(a.repeatError,5):'—'}</td><td>${a.n>=3?f(a.hysteresis,5):'—'}</td><td>${esc(a.text)}</td></tr>`}).join('');
    const head=`<div class="report-head"><h1>${esc(c.experimentName)}</h1><p>电位差计校准分析报告｜实验人员：${esc(c.operator||'未填写')}｜日期：${esc(c.date||'未填写')}｜温度：${esc(c.temperature)} ℃</p></div>`;
    r.innerHTML=`<section class="report-page">${head}<h2>一、仪器与计算依据</h2><table><tbody><tr><th>电位差计</th><td>UJ36A，${c.potAccuracy}级</td><th>电阻箱</th><td>ZX21A，${c.resistance} Ω</td></tr><tr><th>被校毫安表</th><td>0～${c.fullScale} mA，铭牌${c.meterClass}级</td><th>最大允许误差</th><td>±${f(last.mpe,5)} mA</td></tr><tr><th>黄色预警线</th><td colspan="3">${c.nearRatio}×MPE＝${f(warning,5)} mA（教学复核线，不是合格界限）</td></tr><tr><th>电阻误差限</th><td colspan="3">ΔR＝${c.resistanceAccuracy}%×R＋${c.resistanceFixed} Ω＝${f(last.deltaR,5)} Ω</td></tr><tr><th>电位差计误差限</th><td colspan="3">ΔU＝${c.potAccuracy}%×U＋U₁；×1挡U₁＝${c.u1x1} mV，×0.2挡U₁＝${c.u1x02} mV</td></tr></tbody></table><h2>二、结果摘要</h2><table><tbody><tr><th>最大示值误差</th><td>${last.maxError?f(Math.abs(last.maxError.error),5)+' mA（'+last.maxError.point.toFixed(1)+' mA点）':'—'}</td><th>基本误差</th><td>${f(last.assessedPercent,3)}%</td></tr><tr><th>评定等级</th><td>${gradeText}</td><th>点位统计</th><td>${last.counts.fail}超差复测，${last.counts.watch}预警复测，${last.counts.ok}正常</td></tr></tbody></table><p><b>自动结论：</b>${esc(conclusion)}</p><h2>三、校准数据</h2><table><thead><tr><th>示值</th><th>升程U</th><th>降程U</th><th>参考I</th><th>示值误差</th><th>修正值</th><th>升降变差</th><th>B类uB</th><th>状态</th></tr></thead><tbody>${rows}</tbody></table></section><section class="report-page">${head}<h2>四、修正曲线与两类异常筛查</h2>${makeChartSVG(valid,last.mpe,760,410)}<p>示值误差用于判断毫安表示值是否准确；正反行程差用于判断两个测量方向是否一致，在JJG 124—2005中称为“升降变差”。蓝、橙线分别表示升程和降程修正值，黑色粗线为平均修正曲线。红色表示超过限值，黄色表示达到预警线但尚未超限。</p><table><tbody><tr><th>示值误差筛查</th><td>${esc(pointText(last.scans.error))}</td></tr><tr><th>正反行程差筛查</th><td>${esc(pointText(last.scans.hysteresis))}</td></tr></tbody></table><h2>五、异常点复测</h2>${cands.length?`<table><thead><tr><th>点位</th><th>原异常原因</th><th>完整组数</th><th>复测参考I</th><th>复测示值误差</th><th>复测升降变差</th><th>分析</th></tr></thead><tbody>${rr}</tbody></table>`:'<p>无自动标记的复测点。</p>'}</section><section class="report-page">${head}<h2>六、B类标准不确定度预算</h2><p>误差限按矩形分布处理：u<sub>U</sub>＝ΔU/√3，u<sub>R</sub>＝ΔR/√3；u<sub>B</sub>(I)＝I√[(u<sub>U</sub>/Ū)²＋(u<sub>R</sub>/R)²]。本报告不计算扩展不确定度。</p><table><thead><tr><th>点位/mA</th><th>Ū/mV</th><th>ΔU/mV</th><th>uU/mV</th><th>ΔR/Ω</th><th>uR/Ω</th><th>uB(I)/mA</th></tr></thead><tbody>${ub}</tbody></table><h2>七、说明</h2><p>示值误差限值为±MPE；按照JJG 124—2005，升降变差不应超过MPE的绝对值。黄色预警线仅用于安排复测优先级，不代表仪表超差。复测数据不直接覆盖原始记录。B类标准不确定度单独列示，不参与红黄状态判定。</p></section>`
  }
  function csvExport(){calculate();const c=state.config,head=['示值(mA)','升程U(mV)','升程挡位','降程U(mV)','降程挡位','平均U(mV)','参考I(mA)','示值误差(mA)','修正值(mA)','升降变差(mA)','ΔU(mV)','uU(mV)','ΔR(Ω)','uR(Ω)','B类uB(I)(mA)','状态','异常原因'],lines=[`实验名称,${c.experimentName}`,`实验人员,${c.operator}`,`日期,${c.date}`,`UJ36A准确度(%),${c.potAccuracy}`,`ZX21A电阻(Ω),${c.resistance}`,`ZX21A准确度(%),${c.resistanceAccuracy}`,`最大允许误差(mA),${last.mpe}`,`黄色预警线(mA),${c.nearRatio*last.mpe}`,`评定准确度等级,${last.grade}`,'',head.join(',')];last.results.forEach(r=>{if(r.valid)lines.push([r.point,r.up,r.upRange,r.down,r.downRange,r.meanU,r.meanI,r.error,r.correction,r.hysteresis,r.deltaU,r.uU,r.deltaR,r.uR,r.uB,r.statusText,r.reason].map(v=>`"${String(v).replace(/"/g,'""')}"`).join(','))});download('\ufeff'+lines.join('\r\n'),'电位差计校准数据.csv','text/csv;charset=utf-8')}
  function saveProject(){syncConfigFromUI();download(JSON.stringify(state,null,2),'电位差计校准项目.json','application/json')}
  function download(content,name,type){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([content],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500)}
  function saveLocal(){try{localStorage.setItem(storageKey,JSON.stringify(state))}catch(e){}}
  function loadLocal(){try{const saved=JSON.parse(localStorage.getItem(storageKey));if(saved&&saved.rows?.length===15)state=saved}catch(e){}}
  function resetSample(){state={config:{...defaultConfig},rows:sampleRows(),retests:{}};syncConfigToUI();renderTable();calculate()}
  function clearRows(){state.rows.forEach(r=>{r.up=null;r.down=null;r.upRange='x1';r.downRange='x1'});state.retests={};renderTable();calculate()}
  $('#calcBtn').addEventListener('click',calculate);$('#sampleBtn').addEventListener('click',resetSample);$('#saveBtn').addEventListener('click',saveProject);$('#csvBtn').addEventListener('click',csvExport);$('#printBtn').addEventListener('click',()=>{calculate();window.print()});$('#clearBtn').addEventListener('click',()=>{if(confirm('确定清空15点测量数据吗？仪器参数将保留。'))clearRows()});
  $('#loadFile').addEventListener('change',event=>{const file=event.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const saved=JSON.parse(reader.result);if(!saved.rows||saved.rows.length!==15)throw Error('数据格式不正确');state=saved;state.config={...defaultConfig,...state.config};delete state.config.coverageK;delete state.config.localRatio;state.retests=state.retests||{};syncConfigToUI();renderTable();calculate()}catch(e){alert('项目文件无法读取：'+e.message)}};reader.readAsText(file);event.target.value=''});
  document.querySelectorAll('#configForm [data-key]').forEach(el=>el.addEventListener('change',calculate));loadLocal();state.config={...defaultConfig,...state.config};delete state.config.coverageK;delete state.config.localRatio;syncConfigToUI();renderTable();calculate();
})();
</script>
</body>
