<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="UJ36A电位差计校准毫安表数据处理、两类异常自动筛查与复测分析工具">
  <title>电位差计校准分析台</title>
  <style>
    :root{
      --navy:#0b2135;--navy2:#143c5c;--blue:#1677b8;--cyan:#2aa6b8;
      --ink:#162433;--muted:#627486;--line:#d9e4ec;--line2:#eaf0f5;
      --panel:#ffffff;--bg:#f2f6f9;--soft:#f7fafc;
      --green:#14745f;--green-bg:#eaf7f2;--amber:#9a6716;--amber-bg:#fff6dc;
      --red:#b52b24;--red-bg:#fff0ee;--shadow:0 14px 34px rgba(13,42,64,.08);
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:"Microsoft YaHei","PingFang SC",Arial,sans-serif;font-size:16px;line-height:1.55}
    button,input,select,textarea{font:inherit}
    button{cursor:pointer}
    .app-header{background:linear-gradient(110deg,#0b2941,#155171);color:#fff}
    .header-inner{max-width:1480px;margin:0 auto;padding:19px 24px;display:flex;justify-content:space-between;align-items:center;gap:24px}
    .app-header h1{margin:0;font-size:28px;letter-spacing:.03em;line-height:1.2}
    .app-header .subtitle{margin:7px 0 0;color:#d2e7f1;font-size:15px}
    .header-badge{border-left:1px solid rgba(255,255,255,.28);padding:4px 0 4px 18px;color:#d9edf4;font-size:14px;white-space:nowrap}
    .shell{max-width:1480px;margin:0 auto;padding:18px 24px 54px}
    .toolbar{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;gap:14px;padding:12px 0;background:rgba(242,246,249,.94);backdrop-filter:blur(12px)}
    .toolbar-group{display:flex;gap:9px;flex-wrap:wrap}
    button,.button{border:1px solid transparent;border-radius:8px;padding:9px 13px;background:var(--blue);color:#fff;font-weight:700;box-shadow:0 4px 10px rgba(22,119,184,.16);transition:.18s ease;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:6px}
    button:hover,.button:hover{transform:translateY(-1px);filter:brightness(.97)}
    button.secondary,.button.secondary{background:#fff;color:var(--navy2);border-color:#cfdae3;box-shadow:none}
    button.ghost{background:transparent;color:var(--muted);border-color:transparent;box-shadow:none}
    button.danger{background:#fff;color:var(--red);border-color:#edc2be;box-shadow:none}
    input[type=file]{display:none}
    .hero-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(360px,.85fr);gap:16px;margin-bottom:16px}
    .analysis-hero{background:#fff;border:1px solid #dbe6ed;border-radius:14px;padding:20px;box-shadow:0 8px 24px rgba(13,42,64,.055);min-width:0}
    .section-kicker{color:var(--blue);font-size:13px;font-weight:800;letter-spacing:.12em;margin-bottom:5px}
    h2{font-size:21px;line-height:1.3;margin:0;color:var(--navy)}
    h3{font-size:16px;margin:0;color:var(--navy)}
    .hero-conclusion{font-size:17px;color:#365269;margin:10px 0 17px;max-width:900px}
    .metric-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
    .metric{padding:13px 14px;border-left:3px solid #bcd7e8;background:#fff;border-radius:3px 9px 9px 3px;box-shadow:0 3px 12px rgba(13,42,64,.045);min-width:0}
    .metric span{display:block;font-size:13px;color:var(--muted);white-space:nowrap}
    .metric strong{display:block;margin-top:3px;font-size:22px;color:var(--navy);line-height:1.25}
    .metric em{display:block;margin-top:2px;font-size:12px;color:var(--muted);font-style:normal;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .metric.grade{border-left-color:var(--blue)}.metric.fail{border-left-color:var(--red)}.metric.watch{border-left-color:#d69b31}.metric.ub{border-left-color:var(--cyan)}
    .scan-panel{background:#f7fbfd;color:var(--ink);border:1px solid #cfe0e9;border-top:4px solid var(--navy2);border-radius:14px;padding:17px 19px 19px;box-shadow:0 8px 24px rgba(13,42,64,.055);min-width:0}
    .scan-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}
    .scan-head h2{color:var(--navy)}
    .scan-head p{margin:4px 0 0;color:var(--muted);font-size:13px}
    .scan-total{min-width:58px;text-align:center;border:1px solid #c9dce7;background:#fff;border-radius:10px;padding:7px}
    .scan-total b{display:block;font-size:23px;color:var(--navy)}.scan-total span{font-size:11px;color:var(--muted)}
    .scan-list{display:grid;gap:9px}
    .scan-item{padding:10px 11px;background:#fff;border:1px solid #dce7ed;border-radius:9px}
    .scan-item-top{display:flex;justify-content:space-between;gap:12px;align-items:center}
    .scan-item b{font-size:14px;color:var(--navy)}.scan-item small{font-size:12px;color:var(--muted)}
    .scan-definition{margin:7px 0 0;color:#476176;font-size:13px;line-height:1.55}
    .scan-example{margin:8px 0 0;padding:7px 9px;background:#f2f7fa;border-radius:6px;color:#36566c;font-size:12px;line-height:1.55}
    .point-list{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px;min-height:24px}
    .point-tag{display:inline-flex;align-items:center;border-radius:999px;padding:3px 8px;background:#e8f1f6;color:var(--navy);font-size:12px;font-weight:800}
    .point-tag.fail{background:#ffd9d5;color:#8e201a}.point-tag.watch{background:#ffe9a9;color:#754e0c}.point-tag.ok{background:#d8f3e9;color:#0f624f}
    .panel{background:#fff;border:1px solid #dfe8ee;border-radius:14px;box-shadow:0 8px 24px rgba(13,42,64,.055);margin-bottom:16px;overflow:hidden}
    .panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:18px 20px;border-bottom:1px solid var(--line2)}
    .panel-head p{margin:5px 0 0;color:var(--muted);font-size:14px}
    .legend{display:flex;gap:12px;align-items:center;flex-wrap:wrap;color:var(--muted);font-size:13px}
    .legend span{display:inline-flex;align-items:center;gap:6px}
    .dot{width:8px;height:8px;border-radius:50%;display:inline-block}.dot.green{background:var(--green)}.dot.amber{background:#d59a2d}.dot.red{background:var(--red)}
    .config-body{padding:0 20px 20px;border-top:1px solid var(--line2)}
    .form-grid{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:13px;padding-top:17px}
    label{display:block;color:#536a7d;font-size:14px;margin-bottom:6px}
    input,select,textarea{width:100%;border:1px solid #cbd8e1;border-radius:7px;background:#fff;color:var(--ink);padding:8px 9px;min-height:39px}
    input:focus,select:focus,textarea:focus{outline:3px solid #dceef8;border-color:var(--blue)}
    .unit{display:grid;grid-template-columns:1fr auto;align-items:center;gap:7px}.unit>span{color:var(--muted);font-size:13px}
    .method-note{margin-top:15px;padding:11px 13px;background:#eef7fb;border-left:3px solid var(--cyan);border-radius:4px 8px 8px 4px;color:#35566b;font-size:14px}
    .table-wrap{overflow:auto;max-height:600px}
    table{width:100%;border-collapse:collapse;min-width:1220px;background:#fff}
    th{position:sticky;top:0;z-index:2;background:#edf4f8;color:#29485e;font-size:13px;padding:10px 7px;border-bottom:1px solid #cfdae3;white-space:nowrap;text-align:center}
    td{padding:8px 7px;border-bottom:1px solid #edf2f5;text-align:center;white-space:nowrap;font-size:14px}
    tr:last-child td{border-bottom:0}
    td input,td select{padding:6px 7px;min-width:72px;min-height:34px;text-align:center;font-size:14px}
    tr.status-fail{background:var(--red-bg)}tr.status-watch{background:var(--amber-bg)}tr.status-ok{background:#fff}
    .status-pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 9px;font-size:12px;font-weight:800}
    .status-pill::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
    .status-pill.ok{background:var(--green-bg);color:var(--green)}.status-pill.watch{background:var(--amber-bg);color:var(--amber)}.status-pill.fail{background:var(--red-bg);color:var(--red)}
    .analysis-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(330px,.75fr);gap:16px;margin-bottom:16px}
    .analysis-grid>.panel{margin:0}
    .chart-wrap{padding:12px 18px 18px}
    #chartHost svg{width:100%;height:auto;display:block}
    .formula-panel{padding:20px;background:linear-gradient(160deg,#fff 0%,#f7fbfd 100%)}
    .formula-panel h2{margin-bottom:5px}.formula-panel>p{margin:0 0 13px;color:var(--muted);font-size:14px}
    .formula{font-family:Cambria,"Times New Roman",serif;font-size:18px;background:#fff;border:1px solid var(--line);border-radius:9px;padding:11px 12px;margin:8px 0;color:#18364d;overflow:auto}
    .formula-caption{font-family:"Microsoft YaHei","PingFang SC",Arial,sans-serif;font-size:12px;color:var(--muted);display:block;margin-bottom:3px}
    .formula-note{padding:11px 12px;background:#eef7fb;border-radius:8px;margin-top:13px;color:#35566b;font-size:13px}
    .retest-host{padding:4px 20px 20px}
    .retest-intro{margin:0;padding:13px 20px;background:#fff8e7;color:#6d511d;border-bottom:1px solid #f2dfac;font-size:14px}
    .empty{padding:24px 4px;color:var(--muted);text-align:center}
    .retest-card{border:1px solid var(--line);border-left:4px solid #d49a2e;border-radius:5px 10px 10px 5px;padding:15px;margin:12px 0;background:#fbfdff}
    .retest-title{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:12px}.retest-title h3{font-size:17px}.reason-tag{font-size:12px;padding:3px 8px;border-radius:999px;background:#fff0d0;color:#7c5713;font-weight:700}
    .retest-grid{display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:10px;align-items:start}
    .retest-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:10px;border:1px solid #dce7ed;border-radius:8px;background:#fff}
    .retest-pair b{grid-column:1/-1;color:var(--navy);font-size:13px}.retest-pair label{font-size:12px;margin-bottom:4px}.retest-pair input{min-width:0}
    .retest-result{margin-top:12px;padding:10px 12px;background:#edf6fa;border-radius:8px;color:#36566c;font-size:14px}
    .report-only{display:none}
    @media(max-width:1100px){.hero-grid,.analysis-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:repeat(2,1fr)}.metric-row{grid-template-columns:repeat(2,1fr)}.retest-grid{grid-template-columns:1fr 1fr}}
    @media(max-width:700px){body{font-size:15px}.header-inner{padding:18px 16px;align-items:flex-start;flex-direction:column}.app-header h1{font-size:26px}.header-badge{border-left:0;padding:0}.shell{padding:12px 12px 40px}.toolbar{align-items:stretch;flex-direction:column}.toolbar-group{display:grid;grid-template-columns:1fr 1fr}.toolbar-group button,.toolbar-group .button{width:100%}.toolbar-group .ghost{display:none}.metric-row{grid-template-columns:1fr 1fr}.metric strong{font-size:19px}.form-grid{grid-template-columns:1fr}.retest-grid{grid-template-columns:1fr}.panel-head{flex-direction:column}.hero-grid{grid-template-columns:minmax(0,1fr)}.scan-panel{padding:17px}}
    @media print{
      @page{size:A4 portrait;margin:12mm}
      body{background:#fff;font-size:10pt}.screen-only,.app-header{display:none!important}.report-only{display:block!important}
      .shell{max-width:none;margin:0;padding:0}.report-page{page-break-after:always}.report-page:last-child{page-break-after:auto}
      .report-head{border-bottom:2px solid #173e5c;padding-bottom:7px;margin-bottom:12px}.report-head h1{margin:0;color:#173e5c;font-size:20pt}.report-head p{margin:4px 0 0;color:#555}
      .report-only table{min-width:0;font-size:8pt}.report-only th{position:static;padding:4px 3px}.report-only td{padding:4px 3px}
      .report-only h2{font-size:14pt;margin:12px 0 7px}.report-only svg{max-height:210mm}
    }
  </style>
</head>
<body>
<header class="app-header screen-only">
  <div class="header-inner">
    <div>
      <h1>电位差计校准分析台</h1>
      <p class="subtitle">UJ36A + ZX21A｜15点升降程校准｜两类异常自动筛查｜定向复测</p>
    </div>
    <div class="header-badge">B类标准不确定度分析</div>
  </div>
</header>

<main class="shell">
  <section class="screen-only">
    <div class="toolbar">
      <div class="toolbar-group"><button id="calcBtn">重新分析</button><button id="sampleBtn" class="secondary">恢复示例</button><button id="clearBtn" class="danger">清空数据</button></div>
      <div class="toolbar-group"><button id="saveBtn" class="secondary">保存项目</button><label class="button secondary" for="loadFile">导入项目</label><input id="loadFile" type="file" accept="application/json,.json"><button id="csvBtn" class="secondary">导出CSV</button><button id="printBtn">生成报告</button></div>
    </div>

    <section class="panel" aria-labelledby="configTitle"><div class="panel-head"><div><h2 id="configTitle">1. 实验与仪器参数</h2><p>先确认仪器型号、量程、准确度等级和误差参数，再录入测量数据。</p></div></div>
      <div class="config-body"><div class="form-grid" id="configForm">
        <div><label>实验名称</label><input data-key="experimentName" value="UJ36A电位差计校准毫安表"></div><div><label>实验人员</label><input data-key="operator" placeholder="姓名"></div><div><label>实验日期</label><input data-key="date" type="date"></div><div><label>环境温度</label><div class="unit"><input data-key="temperature" type="number" step="0.1" value="20"><span>℃</span></div></div>
        <div><label>毫安表满量程</label><div class="unit"><input data-key="fullScale" type="number" step="0.1" value="1.5"><span>mA</span></div></div><div><label>毫安表铭牌等级</label><div class="unit"><input data-key="meterClass" type="number" step="0.1" value="0.5"><span>级</span></div></div><div><label>ZX21A设置电阻</label><div class="unit"><input data-key="resistance" type="number" step="0.001" value="100"><span>Ω</span></div></div><div><label>ZX21A准确度</label><div class="unit"><input data-key="resistanceAccuracy" type="number" step="0.01" value="0.1"><span>%</span></div></div>
        <div><label>ZX21A固定误差项</label><div class="unit"><input data-key="resistanceFixed" type="number" step="0.001" value="0.005"><span>Ω</span></div></div><div><label>UJ36A准确度</label><div class="unit"><input data-key="potAccuracy" type="number" step="0.01" value="0.1"><span>%</span></div></div><div><label>×1挡最小分度 U₁</label><div class="unit"><input data-key="u1x1" type="number" step="0.01" value="0.05"><span>mV</span></div></div><div><label>×0.2挡最小分度 U₁</label><div class="unit"><input data-key="u1x02" type="number" step="0.01" value="0.01"><span>mV</span></div></div>
        <div><label>黄色预警比例</label><div class="unit"><input data-key="nearRatio" type="number" step="0.05" min="0" max="1" value="0.7"><span>×MPE</span></div></div><div><label>备注</label><input data-key="notes" placeholder="选填"></div>
      </div><div class="method-note">本实验参数下，示值误差限值为 <b id="errorLimitText">±0.00750 mA</b>，升降变差限值为 <b id="variationLimitText">0.00750 mA</b>；超过限值标红，达到70%预警线但尚未超限标黄。黄色预警线由本程序用于提前复核，不是检定规程规定的合格界限。</div></div>
    </section>

    <section class="panel" aria-labelledby="dataTitle"><div class="panel-head"><div><h2 id="dataTitle">2. 15点升降程测量数据</h2><p>输入已经乘过倍率的最终电压值；选择倍率只用于匹配对应的最小分度 U₁。</p></div><div class="legend"><span><i class="dot green"></i>正常</span><span><i class="dot amber"></i>预警复测</span><span><i class="dot red"></i>超差复测</span></div></div>
      <div class="table-wrap"><table id="dataTable"><thead><tr><th>示值/mA</th><th>升程U/mV</th><th>挡位</th><th>降程U/mV</th><th>挡位</th><th>平均U/mV</th><th>参考I/mA</th><th>示值误差/mA</th><th>修正值/mA</th><th>升降变差/mA</th><th>B类u<sub>B</sub>/mA</th><th>判定</th></tr></thead><tbody></tbody></table></div>
    </section>

    <div class="hero-grid">
      <section class="analysis-hero" aria-labelledby="overviewTitle"><div class="section-kicker">ANALYSIS RESULT</div><h2 id="overviewTitle">3. 校准结果摘要</h2><p class="hero-conclusion" id="heroConclusion">正在分析测量数据……</p><div class="metric-row" id="metrics"></div></section>
      <aside class="scan-panel" aria-labelledby="scanTitle"><div class="scan-head"><div><h2 id="scanTitle">两类异常自动筛查</h2><p>逐点判断示值是否准确、正反行程是否一致</p></div><div class="scan-total"><b id="scanCount">0</b><span>复测点</span></div></div><div class="scan-list" id="scanList"></div></aside>
    </div>

    <div class="analysis-grid"><section class="panel" aria-labelledby="chartTitle"><div class="panel-head"><div><h2 id="chartTitle">4. 修正曲线与异常定位</h2><p>蓝、橙线显示升降程差异，黑色粗线为平均修正曲线；绿色区域为±MPE。</p></div></div><div class="chart-wrap" id="chartHost"></div></section>
      <aside class="panel formula-panel" aria-labelledby="formulaTitle"><h2 id="formulaTitle">计算与判定依据</h2><p>两项判定均直接来自正、反行程原始记录。</p><div class="formula"><span class="formula-caption">参考电流</span>I<sub>ref</sub> = (I<sub>↑</sub> + I<sub>↓</sub>) / 2 = Ū / R<sub>s</sub></div><div class="formula"><span class="formula-caption">示值误差：判断毫安表示值是否准确</span>ΔI = I<sub>示</sub> − I<sub>ref</sub><br>C = −ΔI</div><div class="formula"><span class="formula-caption">最大允许误差</span>MPE = (准确度等级 / 100) × 满量程</div><div class="formula"><span class="formula-caption">正反行程差：判断两个测量方向是否一致</span>V = |I<sub>↑</sub> − I<sub>↓</sub>|</div><div class="formula-note">正反行程差在JJG 124—2005中称为“升降变差”，其数值不应超过最大允许误差的绝对值。|ΔI|或V超过限值标红；达到70%预警线但尚未超限标黄。B类不确定度单独列示，不参与红黄判定。</div></aside>
    </div>

    <section class="panel" aria-labelledby="retestTitle"><div class="panel-head"><div><h2 id="retestTitle">5. 异常点复测清单</h2><p>对标记点重新完成升程和降程测量，再判断示值误差与升降变差。</p></div></div><p class="retest-intro">每个点录入3组完整的升、降程复测数据。程序重新计算两项指标；原始记录保留，不直接删除或覆盖。</p><div class="retest-host" id="retestHost"></div></section>
  </section>
  <section id="report" class="report-only"></section>
</main>

<script>
(() => {
  'use strict';
  const sampleUp=[10.70,20.55,30.85,40.75,50.65,60.15,69.85,79.65,89.55,99.20,109.55,119.90,129.55,138.80,149.20];
  const sampleDown=[10.30,20.20,29.95,40.15,49.80,60.10,69.50,79.55,89.40,99.30,109.35,119.20,129.25,139.10,148.85];
  const storageKey='potentiometer-calibration-project-v3';
  const standardClasses=[0.1,0.2,0.5,1.0,1.5,2.5,5.0];
  const $=s=>document.querySelector(s);
  const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const n=v=>{if(v==null||String(v).trim()==='')return null;const x=Number(v);return Number.isFinite(x)?x:null};
  const f=(v,d=5)=>v==null||!Number.isFinite(v)?'—':Number(v).toFixed(d);
  const today=()=>new Date().toISOString().slice(0,10);
  const defaultConfig={experimentName:'UJ36A电位差计校准毫安表',operator:'',date:today(),temperature:20,fullScale:1.5,meterClass:.5,resistance:100,resistanceAccuracy:.1,resistanceFixed:.005,potAccuracy:.1,u1x1:.05,u1x02:.01,nearRatio:.7,notes:''};
  const sampleRows=()=>Array.from({length:15},(_,i)=>({point:(i+1)/10,up:sampleUp[i],upRange:'x1',down:sampleDown[i],downRange:'x1'}));
  let state={config:{...defaultConfig},rows:sampleRows(),retests:{}};
  let last=null;
  function syncConfigFromUI(){document.querySelectorAll('#configForm [data-key]').forEach(el=>{const key=el.dataset.key;state.config[key]=el.type==='number'?n(el.value):el.value})}
  function syncConfigToUI(){document.querySelectorAll('#configForm [data-key]').forEach(el=>{el.value=state.config[el.dataset.key]??''})}
  function maxPermissibleError(){const c=state.config;return (c.meterClass/100)*c.fullScale}
