  function makeChartSVG(data,mpe,w,h){
    const pad={l:76,r:76,t:42,b:58},pw=w-pad.l-pad.r,ph=h-pad.t-pad.b;
    const ys=data.flatMap(d=>[d.upCorrection,d.downCorrection,d.correction,-mpe,mpe]),rawMin=Math.min(...ys),rawMax=Math.max(...ys),span=rawMax-rawMin||.01;
