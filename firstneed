  function renderOverview(){if(!last)return;const s=last,c=state.config,ready=s.validCount===15;let conclusion='请补全升降程数据后生成校准结论。';if(s.validCount){const gradeText=typeof s.grade==='number'?s.grade.toFixed(1)+'级':String(s.grade);conclusion=`已完成${s.validCount}个点分析。最大绝对示值误差为${f(Math.abs(s.maxError.error),5)} mA，基本误差为${f(s.assessedPercent,3)}%，按相邻标准等级向上选取为${gradeText}${ready&&typeof s.grade==='number'&&s.grade>c.meterClass?'，不能满足铭牌'+c.meterClass+'级要求':'。'}`}$('#heroConclusion').textContent=conclusion;const gradeText=s.grade==null?'—':(typeof s.grade==='number'?s.grade.toFixed(1)+'级':s.grade+'级');$('#metrics').innerHTML=`<div class="metric grade"><span>评定准确度等级</span><strong>${esc(gradeText)}</strong><em>基本误差 ${f(s.assessedPercent,3)}%</em></div><div class="metric fail"><span>超差复测点</span><strong>${s.counts.fail}</strong><em>${pointText(s.valid.filter(x=>x.status==='fail'))}</em></div><div class="metric watch"><span>预警复测点</span><strong>${s.counts.watch}</strong><em>${pointText(s.valid.filter(x=>x.status==='watch'))}</em></div><div class="metric ub"><span>最大B类 uB</span><strong>${s.maxUB?f(s.maxUB.uB,6):'—'}</strong><em>${s.maxUB?'位于 '+s.maxUB.point.toFixed(1)+' mA点':'mA'}</em></div>`}
  function renderScanPanel(){
